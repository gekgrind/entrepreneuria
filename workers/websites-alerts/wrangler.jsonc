// Template. Replace the REPLACE_ME values before `wrangler deploy` (README.md).
// The webhook secret is NOT here: set it with `wrangler secret put ALERT_WEBHOOK_SECRET`.
{
  "name": "entrepreneuria-websites-alerts",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  // Receiver hostname (Cloudflare creates its DNS record). Kept separate from the
  // sending subdomain (alerts.entrepreneuria.io) so the two never share records.
  "routes": [{ "pattern": "hooks.entrepreneuria.io", "custom_domain": true }],
  "vars": {
    "ALERT_EMAIL_TO": "misti@entrepreneuria.io",
    "ALERT_EMAIL_FROM": "alerts@alerts.entrepreneuria.io"
  },
  "send_email": [
    // Restricted to the single verified destination: the Worker cannot email anyone else.
    { "name": "ALERT_EMAIL", "destination_address": "misti@entrepreneuria.io" }
  ],
  "kv_namespaces": [
    // Create with: wrangler kv namespace create ALERT_DEDUPE
    { "binding": "ALERT_DEDUPE", "id": "REPLACE_ME" }
  ]
}
