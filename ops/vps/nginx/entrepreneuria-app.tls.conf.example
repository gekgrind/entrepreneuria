# Step 2: TLS site for <host> proxying to the app's loopback port (/etc/nginx/sites-available/<host>.conf).
# Syntax is for Ubuntu 24.04's nginx 1.24 (`listen ... ssl http2`; the `http2 on;`
# directive needs >= 1.25.1). Requires 00-entrepreneuria-http.conf for the
# $connection_upgrade map and the default servers.
#
# Header contract with the app (lib/services/websites/gate.ts, request-guards.ts):
#   - Host and X-Forwarded-Host both carry the visitor's host, or the Websites
#     gate fails closed (404).
#   - X-Real-IP / X-Forwarded-For are OVERWRITTEN with the TCP peer address, so a
#     client-supplied value can never reach the app. This assumes visitors connect
#     directly to nginx. If a CDN/proxy (e.g. Cloudflare) is put in front later,
#     configure ngx_http_realip_module with that provider's ranges only, first.

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name <host>;

    ssl_certificate     /etc/letsencrypt/live/<host>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<host>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:entrepreneuria_tls:10m;
    ssl_session_tickets off;

    client_max_body_size 4m;

    location / {
        proxy_pass http://127.0.0.1:<port>;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header Forwarded         "";

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name <host>;

    # Keep renewals working.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
