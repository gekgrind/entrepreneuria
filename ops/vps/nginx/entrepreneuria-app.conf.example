# Example server block for one app. Copy per host; replace <host> and <port>.
# TLS directives come from certbot. Not installed by any script in this repo.
#
# Header contract with the app (lib/services/websites/gate.ts, request-guards.ts):
#   - Host and X-Forwarded-Host must both carry the visitor's host, or the
#     Websites gate fails closed (404).
#   - X-Real-IP is OVERWRITTEN with the socket address; the app never reads
#     X-Forwarded-For for rate limiting.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <host>;

    server_tokens off;
    client_max_body_size 4m;

    location / {
        proxy_pass http://127.0.0.1:<port>;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP         $remote_addr;
        # Overwrite, never append ($proxy_add_x_forwarded_for appends client-supplied values).
        proxy_set_header X-Forwarded-For   $remote_addr;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name <host>;
    return 301 https://$host$request_uri;
}

# In http {} once:
#   map $http_upgrade $connection_upgrade { default upgrade; '' close; }
#   server { listen 80 default_server; listen [::]:80 default_server; return 444; }
#   server { listen 443 ssl default_server; listen [::]:443 ssl default_server;
#            ssl_reject_handshake on; }
