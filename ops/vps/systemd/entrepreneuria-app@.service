# One Next.js app per instance: entrepreneuria-app@<app>.service
# (e.g. entrepreneuria-app@hub.service). Installed by ops/vps/bin/provision-app.sh.
#
# Isolation model (ops/vps/README.md):
#   - runs as the dedicated, non-sudo, nologin user app-<app>
#   - executes a root-owned release published by entrepreneuria-promote; neither
#     the runtime user nor the build user can modify releases or the live pointer
#   - secrets come from a root-only file that systemd (PID 1) reads before
#     dropping privileges
#   - binds to loopback only; nginx is the only public listener
# The unit is enabled at boot by entrepreneuria-promote after the first healthy
# activation, never by provisioning.

[Unit]
Description=Entrepreneuria app %i (Next.js, loopback only)
After=network-online.target
Wants=network-online.target
# Never start without a promoted release selected.
ConditionPathIsSymbolicLink=/srv/%i/live/current
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=app-%i
Group=app-%i
WorkingDirectory=/srv/%i/live/current

# Application secrets: root:root 0600, read by PID 1 only. Must not set PORT,
# HOSTNAME or NODE_OPTIONS (entrepreneuria-promote refuses to activate if it does).
EnvironmentFile=/srv/%i/secrets/runtime.env
# Non-secret listener settings (PORT=...), generated from /etc/entrepreneuria/apps/%i.conf.
# Read last so it wins over anything above.
EnvironmentFile=/srv/%i/config/service.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1

# Explicit loopback bind. Never 0.0.0.0 / ::.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port ${PORT}

Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# --- Sandboxing ---------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
# The only writable path: Next's runtime cache (.next/cache -> var/cache) and app data.
ReadWritePaths=/srv/%i/var
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
# V8 needs W+X pages; do not set MemoryDenyWriteExecute.

# Per-app MemoryMax comes from a drop-in written by provisioning:
#   /etc/systemd/system/entrepreneuria-app@<app>.service.d/limits.conf
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
